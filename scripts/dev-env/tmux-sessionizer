#!/bin/bash

PROJECT_FILE="$HOME/.project_dirs"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=worktree-helper
source "$SCRIPT_DIR/worktree-helper"

# Function to add the current directory to the project file
add_project() {
    local current_dir="$(pwd)"
    local git_dir
    if git_dir=$(git rev-parse --git-common-dir 2>/dev/null); then
        current_dir=$(cd "$(dirname "$git_dir")" && pwd)
    fi
    touch "$PROJECT_FILE"

    if ! grep -Fxq "$current_dir" "$PROJECT_FILE"; then
        echo "$current_dir" >> "$PROJECT_FILE"
        echo "Added: $current_dir"
    else
        echo "Already exists: $current_dir"
    fi
}

# Function to switch to a tmux session
switch_to() {
    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$1"
    else
        tmux switch-client -t "$1"
    fi
}

# Function to check if a tmux session exists
has_session() {
    tmux list-sessions | grep -iq "^$1:"
}

# Function to get the current git branch for a directory, if any
git_branch() {
    git -C "$1" branch --show-current </dev/null 2>/dev/null
}

# Function to hydrate a tmux session with sessionizer
hydrate() {
    DEFAULT_CONFIG="$HOME/.dotfiles/scripts/dev-env/.tmux-sessionizer"
    if [[ -f "$2/.tmux-sessionizer" ]]; then
        tmux send-keys -t "$1" "source $2/.tmux-sessionizer" C-m
    elif [[ -f $DEFAULT_CONFIG ]]; then
        tmux send-keys -t "$1" "source $DEFAULT_CONFIG" C-m
	fi
}

# Function to start the tmux environment
start_env() {
    local match="$1"

    if [[ ! -s "$PROJECT_FILE" ]]; then
        echo "No projects found. Use the script with -a to add a project first."
        exit 1
    fi

    local selected

    # Expand each root into the root itself plus its currently registered
    # worktrees. The helper queries Git on every invocation, so removed
    # worktrees disappear without editing ~/.project_dirs.
    project_entries() {
        local root root_real repo_root path branch detached
        while IFS= read -r root <&3; do
            [[ -z "$root" ]] && continue
            root_real=$(cd "$root" 2>/dev/null && pwd -P) || root_real="$root"
            branch=$(git_branch "$root")
            printf '%s\t%s\n' "$root" "$branch"

            # Only enumerate worktrees when this registration is the
            # physical top-level of its repository, not a path inside/
            # symlinked into one (e.g. ~/.config/nvim -> this repo) —
            # otherwise the containing repo's own worktrees leak in here.
            repo_root=$(git -C "$root" rev-parse --show-toplevel 2>/dev/null) || repo_root=
            repo_root=$(cd "$repo_root" 2>/dev/null && pwd -P) || repo_root=
            if [[ -n "$repo_root" && "$root_real" == "$repo_root" ]]; then
                while IFS=$'\t' read -r path branch detached; do
                    [[ "$path" == "$root_real" ]] && continue
                    # Subagent worktrees are Herdr-owned and must stay out of
                    # the human tmux picker. Keep this a naming/branch check
                    # against the record already returned by worktree_records.
                    [[ "$path" == *_agent_*_worktree ]] && continue
                    [[ "$branch" == agent/* ]] && continue
                    printf '%s\t%s\n' "$path" "$branch"
                done < <(worktree_records "$root" 2>/dev/null || true)
            fi
        done 3< "$PROJECT_FILE"
    }

    if [[ -z "$match" ]]; then
        local entries width=0 dir branch
        entries=$(project_entries | awk -F '\t' '!seen[$1]++')

        while IFS=$'\t' read -r dir branch; do
            if (( ${#dir} > width )); then
                width=${#dir}
            fi
        done <<< "$entries"

        selected=$(
            while IFS=$'\t' read -r dir branch; do
                if [[ -n "$branch" ]]; then
                    printf '%-*s\t\033[33m[%s]\033[0m\n' "$width" "$dir" "$branch"
                else
                    printf '%-*s\t\n' "$width" "$dir"
                fi
            done <<< "$entries" \
            | fzf --ansi --height=40% --reverse \
                  --prompt="Select a project: " \
                  --delimiter='\t' --with-nth=1,2 --nth=1,2 \
                  | cut -f1
        )
        selected="${selected%"${selected##*[![:space:]]}"}"
    else
        selected=$(project_entries | grep -i "$match" | head -n 1 | cut -f1)
    fi

    if [[ -z "$selected" ]]; then
        echo "No match found for '$match'"
        exit 1
    fi

    selected_name=$(echo "$selected" | sed "s|$HOME/||" | tr '/' '_' | tr '.' '_' | head -c 64)
    tmux_running=$(pgrep tmux)

    if [[ -z "$TMUX" ]] && [[ -z "$tmux_running" ]]; then
        tmux new-session -ds "$selected_name" -c "$selected"
        hydrate "$selected_name" "$selected"
        tmux attach-session -t "$selected_name"
        exit 0
    fi

    if ! has_session "$selected_name"; then
        tmux new-session -ds "$selected_name" -c "$selected"
        hydrate "$selected_name" "$selected"
    fi

    switch_to "$selected_name"
}

list_sessions() {
    echo "Active tmux sessions:"
    tmux list-sessions 2>/dev/null || echo "No active sessions."
}

case "$1" in
    -a)
        add_project
        ;;
    -l)
        list_sessions
        ;;
    -k)
        tmux kill-server
        ;;
    *)
        start_env "$1"
        ;;
esac
