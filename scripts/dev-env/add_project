#!/bin/bash

FILE="$HOME/.project_dirs"
PWD_DIR="$(pwd)"

# Create the file if it doesn't exist
touch "$FILE"

# Check if the directory is already in the file
if ! grep -Fxq "$PWD_DIR" "$FILE"; then
    echo "$PWD_DIR" >> "$FILE"
    echo "Added: $PWD_DIR"
else
    echo "Directory already exists in $FILE"
fi
