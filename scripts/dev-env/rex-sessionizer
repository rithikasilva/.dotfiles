#!/usr/bin/env bash

# Select a registered project or worktree, then select or create its persistent
# Rex session. This intentionally shares ~/.project_dirs and worktree discovery
# with tmux-sessionizer so the two launchers can coexist during migration.

set -euo pipefail

PROJECT_FILE="$HOME/.project_dirs"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=worktree-helper
source "$SCRIPT_DIR/worktree-helper"

rex_bin() {
    if command -v rex >/dev/null 2>&1; then
        command -v rex
        return
    fi

    local bundled='/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex'
    [[ -x "$bundled" ]] || {
        echo 'Rex CLI not found. Run this from a Rex terminal.' >&2
        return 1
    }
    printf '%s\n' "$bundled"
}

usage() {
    cat <<'EOF'
Usage: rs [OPTION | QUERY]

Select a registered project or Git worktree and switch to its persistent Rex
session. A missing session is created with an Editor (nvim) and Scratch shell
window. Existing sessions are reused.

Options:
  -a             Register the current project root in ~/.project_dirs.
  -l             List registered projects and worktrees with full paths and
                 branches; useful as input to fzf.
  -h, --help     Show this help.

Arguments:
  DIRECTORY      Register DIRECTORY, then create or open its Rex workspace.
  QUERY          Open the first registered project/worktree whose path contains
                 QUERY (case-insensitive), without opening the fzf picker.

Shortcuts:
  Ctrl-F         Switch among existing Rex sessions with Rex's native picker.
  Ctrl-S P       Open this picker in a transient floating Rex terminal.
  Shift-Cmd-G    Rex's native Go to Directory picker (opens a terminal/tab,
                 rather than an rs Editor + Scratch workspace).
  Shift-Cmd-N    Rex's native blank New Session dialog.
  Ctrl-S A       Show Rex's per-pane activity view.
  ras            Summarize active Codex, Claude, and pi panes across sessions.
EOF
}

add_project_path() {
    local current_dir="$1" git_dir
    current_dir=$(cd "$current_dir" && pwd -P)
    if git_dir=$(git -C "$current_dir" rev-parse --path-format=absolute \
        --git-common-dir 2>/dev/null); then
        current_dir=$(cd "$(dirname "$git_dir")" && pwd)
    fi

    touch "$PROJECT_FILE"
    if ! grep -Fxq "$current_dir" "$PROJECT_FILE"; then
        printf '%s\n' "$current_dir" >> "$PROJECT_FILE"
        printf 'Added: %s\n' "$current_dir"
    else
        printf 'Already exists: %s\n' "$current_dir"
    fi
}

add_project() {
    add_project_path "$PWD"
}

git_branch() {
    git -C "$1" branch --show-current </dev/null 2>/dev/null
}

expand_root() {
    local root="$1" root_real repo_root path branch detached
    root_real=$(cd "$root" 2>/dev/null && pwd -P) || root_real="$root"
    branch=$(git_branch "$root")
    printf '%s\t%s\n' "$root" "$branch"

    repo_root=$(git -C "$root" rev-parse --show-toplevel 2>/dev/null) || repo_root=
    repo_root=$(cd "$repo_root" 2>/dev/null && pwd -P) || repo_root=
    if [[ -n "$repo_root" && "$root_real" == "$repo_root" ]]; then
        while IFS=$'\t' read -r path branch detached; do
            [[ "$path" == "$root_real" ]] && continue
            printf '%s\t%s\n' "$path" "$branch"
        done < <(worktree_records "$root" 2>/dev/null || true)
    fi
}

project_entries() {
    local root tmpdir pid i=0
    local -a pids=()
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/rex-sessionizer.XXXXXX") || return 1
    trap 'rm -rf "$tmpdir"' RETURN

    while IFS= read -r root <&3; do
        [[ -z "$root" ]] && continue
        i=$((i + 1))
        expand_root "$root" > "$tmpdir/$i" &
        pids+=("$!")
    done 3< "$PROJECT_FILE"

    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null
    done
    cat "$tmpdir"/* 2>/dev/null
}

list_projects() {
    local entries width=0 dir branch
    [[ -s "$PROJECT_FILE" ]] || {
        echo 'No projects found. Use rex-sessionizer -a from a project root first.' >&2
        return 1
    }

    entries=$(project_entries | awk -F '\t' '!seen[$1]++')
    while IFS=$'\t' read -r dir branch; do
        (( ${#dir} > width )) && width=${#dir}
    done <<< "$entries"

    while IFS=$'\t' read -r dir branch; do
        if [[ -n "$branch" ]]; then
            printf '%-*s\t[%s]\n' "$width" "$dir" "$branch"
        else
            printf '%-*s\n' "$width" "$dir"
        fi
    done <<< "$entries"
}

choose_project() {
    [[ -s "$PROJECT_FILE" ]] || {
        echo 'No projects found. Use rex-sessionizer -a from a project root first.' >&2
        return 1
    }

    local entries width=0 dir branch
    entries=$(project_entries | awk -F '\t' '!seen[$1]++')
    while IFS=$'\t' read -r dir branch; do
        (( ${#dir} > width )) && width=${#dir}
    done <<< "$entries"

    while IFS=$'\t' read -r dir branch; do
        if [[ -n "$branch" ]]; then
            printf '%-*s\t\033[33m[%s]\033[0m\n' "$width" "$dir" "$branch"
        else
            printf '%-*s\t\n' "$width" "$dir"
        fi
    done <<< "$entries" \
        | fzf --ansi --height=40% --reverse --prompt='Select a Rex workspace: ' \
              --delimiter='\t' --with-nth=1,2 --nth=1,2 \
        | cut -f1 \
        | sed 's/[[:space:]]*$//'
}

session_label() {
    local path="$1" branch digest
    branch=$(git_branch "$path")
    digest=$(printf '%s' "$path" | shasum -a 256 | cut -c1-8)
    if [[ -n "$branch" ]]; then
        printf '%s [%s] · %s\n' "$path" "$branch" "$digest"
    else
        printf '%s · %s\n' "$path" "$digest"
    fi
}

find_session() {
    local path="$1" suffix sessions
    suffix=" · $(printf '%s' "$path" | shasum -a 256 | cut -c1-8)"
    sessions=$("$REX" ls --json | jq -r --arg suffix "$suffix" \
        '[.sessions[] | select(.label | endswith($suffix)) | .session_id] | .[]')
    local count
    count=$(printf '%s\n' "$sessions" | sed '/^$/d' | wc -l | tr -d ' ')
    [[ "$count" == 0 ]] && return 1
    [[ "$count" == 1 ]] || {
        echo "More than one Rex session matches: $suffix" >&2
        return 2
    }
    printf '%s\n' "$sessions"
}

select_in_app() {
    local session_id="$1"
    if [[ -n "${REX_CLIENT:-}" ]]; then
        "$REX" -C "$REX_CLIENT" do session.select "session_id=$session_id"
    else
        "$REX" do session.select "session_id=$session_id"
    fi
}

open_workspace() {
    local selected="$1" label created session_id
    label=$(session_label "$selected")

    if session_id=$(find_session "$selected"); then
        "$REX" session rename "$session_id" "$label"
        select_in_app "$session_id"
        return
    fi

    created=$("$REX" new "$label" -c "$selected" --window Editor --json -- nvim)
    session_id=$(printf '%s' "$created" | jq -er '.session_id')
    "$REX" window new -s "$session_id" Scratch -c "$selected" --json >/dev/null
    select_in_app "$session_id"
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

REX=$(rex_bin)

case "${1:-}" in
    -a)
        add_project
        ;;
    -l)
        list_projects
        ;;
    '')
        open_workspace "$(choose_project)"
        ;;
    *)
        if [[ -d "$1" ]]; then
            selected=$(cd "$1" && pwd -P)
            add_project_path "$selected"
        else
            selected=$(project_entries | awk -F '\t' -v query="$1" \
                'BEGIN { IGNORECASE = 1 } index($1, query) { print $1; exit }')
            [[ -n "$selected" ]] || {
                echo "No workspace matches: $1" >&2
                exit 1
            }
        fi
        open_workspace "$selected"
        ;;
esac
