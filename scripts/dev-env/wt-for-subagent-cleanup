#!/bin/bash
# Remove a subagent worktree created by wt-for-subagent, plus its branch.
#
# Usage:
#   wt-for-subagent-cleanup --path <path> [--repo <path>]

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=worktree-helper
source "$SCRIPT_DIR/worktree-helper"

usage() {
    cat >&2 <<'EOF'
Usage: wt-for-subagent-cleanup --path <worktree-path> [--repo <path>]
       wt-for-subagent-cleanup --path <removed-worktree-path> --branch <agent/branch> --force-branch [--repo <path>]

Removes a worktree previously created by wt-for-subagent (a
<root>_agent_<id>_worktree sibling) and deletes its branch. Refuses to
touch a worktree whose path is not in the reserved agent naming
convention, a worktree with uncommitted changes, or one whose branch is
not fully merged/cherry-picked into any other branch (use --force-branch
to delete an unmerged branch anyway once its commits have been
cherry-picked elsewhere). The second form recovers a branch left behind
when a prior cleanup removed its worktree before finding that it was not
Git-merged; it requires both the exact agent branch and --force-branch.
EOF
    exit "${1:-1}"
}

path=""
repo=""
force_branch=false
branch_override=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --path)
            [[ $# -ge 2 && -n "$2" ]] || usage
            path="$2"
            shift 2
            ;;
        --repo)
            [[ $# -ge 2 && -n "$2" ]] || usage
            repo="$2"
            shift 2
            ;;
        --branch)
            [[ $# -ge 2 && -n "$2" ]] || usage
            branch_override="$2"
            shift 2
            ;;
        --force-branch)
            force_branch=true
            shift
            ;;
        -h|--help)
            [[ $# -eq 1 ]] || usage
            usage 0
            ;;
        *)
            usage
            ;;
    esac
done

[[ -n "$path" ]] || usage
repo="${repo:-.}"
if [[ -n "$branch_override" && "$force_branch" != true ]]; then
    echo "--branch is only valid with --force-branch recovery cleanup." >&2
    exit 1
fi

git_dir=$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null) || {
    echo "Not a Git repository: $repo" >&2
    exit 1
}
git_dir=$(cd "$git_dir" && pwd -P)
main_worktree=$(cd "$(dirname "$git_dir")" && pwd -P)
root_name=$(basename "$main_worktree")
parent_dir=$(dirname "$main_worktree")

# Serialize cleanup with allocation, and recover locks left by crashed
# processes using the same owner metadata convention as the creators.
lock_dir="$git_dir/wt.lock"
mkdir -p "$(dirname "$lock_dir")"
got_lock=false
for _ in $(seq 1 600); do
    if mkdir "$lock_dir" 2>/dev/null; then
        printf '%s\n' "$$" > "$lock_dir/owner"
        trap 'rm -f "$lock_dir/owner"; rmdir "$lock_dir" 2>/dev/null || true' EXIT
        got_lock=true
        break
    fi
    lock_pid=""
    [[ -f "$lock_dir/owner" ]] && read -r lock_pid < "$lock_dir/owner" || true
    if [[ ! "$lock_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
        rm -f "$lock_dir/owner"
        rmdir "$lock_dir" 2>/dev/null || true
    fi
    sleep 0.1
done
[[ "$got_lock" == true ]] || {
    echo "Timed out waiting for worktree lock: $lock_dir" >&2
    exit 1
}

# Canonicalize the parent even when recovery is operating on a path that no
# longer exists.
if [[ -e "$path" ]]; then
    path=$(cd "$path" 2>/dev/null && pwd -P) || {
        echo "Could not resolve worktree path: $path" >&2
        exit 1
    }
else
    path="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)/$(basename "$path")" || {
        echo "Could not resolve worktree parent: $path" >&2
        exit 1
    }
fi
path_parent=$(dirname "$path")
path_base=$(basename "$path")
if [[ "$path_parent" != "$parent_dir" ]] || [[ "$path_base" != "${root_name}_agent_"*"_worktree" ]]; then
    echo "Refusing '$path': not a reserved sibling subagent worktree of $main_worktree." >&2
    exit 1
fi

if [[ -e "$path" ]]; then
    :
elif [[ -n "$branch_override" && "$force_branch" == true ]]; then
    # `git worktree remove` may have already succeeded before `branch -d`
    # discovers a cherry-picked (rather than merged) branch.  Keep recovery
    # in this guarded wrapper instead of requiring a hand-run `git branch -D`.
    [[ "$branch_override" == agent/* ]] || {
        echo "Refusing recovery: branch '$branch_override' is outside the reserved agent/ namespace." >&2
        exit 1
    }
    git -C "$main_worktree" show-ref --verify --quiet "refs/heads/$branch_override" || {
        echo "Agent branch does not exist: $branch_override" >&2
        exit 1
    }
    while IFS=$'\t' read -r _existing existing_branch _detached; do
        [[ "$existing_branch" != "$branch_override" ]] || {
            echo "Refusing recovery: branch '$branch_override' is still checked out in a live worktree." >&2
            exit 1
        }
    done < <(worktree_records "$main_worktree")
    git -C "$main_worktree" branch -D "$branch_override"
    echo "Removed leftover agent branch '$branch_override' after prior worktree cleanup." >&2
    exit 0
else
    echo "Worktree path does not exist: $path" >&2
    exit 1
fi

if [[ "$path" == "$main_worktree" ]]; then
    echo "Refusing to remove the main worktree." >&2
    exit 1
fi

branch=""
found=false
while IFS=$'\t' read -r existing existing_branch _detached; do
    [[ "$existing" == "$path" ]] || continue
    found=true
    branch="$existing_branch"
done < <(worktree_records "$main_worktree")

if [[ "$found" == false ]]; then
    echo "'$path' is not a live worktree of $main_worktree." >&2
    exit 1
fi

if [[ -n "$(git -C "$path" status --porcelain 2>&1)" ]]; then
    echo "Refusing to remove '$path': it has uncommitted changes." >&2
    exit 1
fi

if [[ -n "$branch" && "$branch" != agent/* ]]; then
    echo "Refusing to remove '$path': its branch '$branch' is outside the reserved agent/ namespace." >&2
    exit 1
fi

git -C "$main_worktree" worktree remove "$path"

if [[ -n "$branch" ]]; then
    if [[ "$force_branch" == true ]]; then
        git -C "$main_worktree" branch -D "$branch"
    else
        if ! git -C "$main_worktree" branch -d "$branch" 2>/dev/null; then
            echo "Worktree removed, but branch '$branch' is not fully merged and was left in place." >&2
            echo "If its commits were already cherry-picked elsewhere, rerun with --force-branch to delete it." >&2
            exit 1
        fi
    fi
fi

echo "Removed worktree '$path' and branch '${branch:-<none>}'." >&2
