#!/bin/bash
# Provision, launch, wait for, and collect one Herdr subagent run.
#
# Cleanup is deliberately opt-in.  Use --cleanup integrate or --cleanup discard
# after reviewing the report; the command requires a typed acknowledgement.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

usage() {
    cat >&2 <<'EOF'
Usage: subagent-run --branch <short-task-name> --name <agent-name>
       [--repo <path>] [--base <ref>] [--persona <name>]
       [--prompt-file <file>|-] [--timeout <milliseconds>]
       [--cleanup integrate|discard] -- <prompt text...>

Creates a reserved worktree, launches the prompt through Herdr, waits for a
settled state, and prints the persistent report.  Without --cleanup it leaves
the worktree, Herdr tab, and branch for manual audit.  Cleanup requires typing
INTEGRATE or DISCARD at the terminal after the report is displayed.  The
acknowledged cleanup closes this invocation's Herdr workspace before removing
the worktree.
EOF
    exit "${1:-1}"
}

repo=""
branch=""
name=""
prompt_file=""
persona=""
timeout=600000
cleanup=""
prompt_args=()
separator=false
while [[ $# -gt 0 ]]; do
    if [[ "$separator" == true ]]; then prompt_args+=("$1"); shift; continue; fi
    case "$1" in
        --repo) [[ $# -ge 2 && -n "$2" ]] || usage; repo="$2"; shift 2 ;;
        --branch|--new-branch) [[ $# -ge 2 && -n "$2" ]] || usage; branch="$2"; shift 2 ;;
        --name) [[ $# -ge 2 && -n "$2" ]] || usage; name="$2"; shift 2 ;;
        --base) [[ $# -ge 2 && -n "$2" ]] || usage; base="$2"; shift 2 ;;
        --persona) [[ $# -ge 2 && -n "$2" ]] || usage; persona="$2"; shift 2 ;;
        --prompt-file) [[ $# -ge 2 && -n "$2" ]] || usage; prompt_file="$2"; shift 2 ;;
        --timeout) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || usage; timeout="$2"; shift 2 ;;
        --cleanup)
            [[ $# -ge 2 ]] || usage
            [[ "$2" == integrate || "$2" == discard ]] || usage
            cleanup="$2"
            shift 2
            ;;
        --) separator=true; shift ;;
        -h|--help) [[ $# -eq 1 ]] || usage; usage 0 ;;
        *) echo "Unknown argument: $1 (use -- before prompt text)." >&2; usage ;;
    esac
done

[[ -n "$branch" ]] || { echo "--branch is required." >&2; exit 2; }
[[ -n "$name" ]] || { echo "--name is required." >&2; exit 2; }
[[ -n "$prompt_file" || ${#prompt_args[@]} -gt 0 ]] || { echo "A prompt is required (use --prompt-file)." >&2; exit 2; }
if [[ -n "$prompt_file" && ${#prompt_args[@]} -gt 0 ]]; then
    echo "--prompt-file and prompt text are mutually exclusive." >&2
    exit 2
fi
repo="${repo:-.}"
command -v jq >/dev/null 2>&1 || { echo "jq is required to parse helper output." >&2; exit 1; }
base_args=()
[[ -n "${base:-}" ]] && base_args+=(--base "$base")

# Keep the helper's JSON as the source of truth for the allocated path.
worktree_json=$("$SCRIPT_DIR/wt-for-subagent" --repo "$repo" --new-branch "$branch" "${base_args[@]}" ) || exit $?
worktree=$(jq -er '.path' <<<"$worktree_json")

launch_args=(--worktree "$worktree" --name "$name")
[[ -n "$persona" ]] && launch_args+=(--persona "$persona")
if [[ -n "$prompt_file" ]]; then launch_args+=(--prompt-file "$prompt_file"); else launch_args+=(-- "${prompt_args[@]}"); fi

launch_json=$("$SCRIPT_DIR/subagent-launch" "${launch_args[@]}" ) || {
    echo "Launch failed; leaving $worktree for inspection (no cleanup was attempted)." >&2
    exit 1
}
agent=$(jq -er '.agent' <<<"$launch_json")
report=$(jq -er '.report' <<<"$launch_json")
workspace=$(jq -er '.workspace' <<<"$launch_json")
tab=$(jq -er '.tab' <<<"$launch_json")
workspace_reused=$(jq -er '.workspace_reused' <<<"$launch_json")
printf 'Launched %s in worktree %s (workspace %s, tab %s).\n' "$agent" "$worktree" "$workspace" "$tab"

wait_status=0
set +e
herdr agent wait "$agent" --until idle --until done --until blocked --timeout "$timeout"
wait_status=$?
set -e
if [[ "$wait_status" -ne 0 ]]; then
    echo "Herdr wait did not reach a settled state (exit $wait_status)." >&2
fi

printf '\n=== Persistent report: %s ===\n' "$report"
if [[ -f "$report" ]]; then
    cat "$report"
    printf '\n=== End report ===\n'
else
    echo "Report not found yet. Inspect the agent and retry after it settles: $report" >&2
fi

if [[ -z "$cleanup" ]]; then
    echo "Manual audit mode: no cleanup performed. Close tab $tab, integrate or discard, then run wt-for-subagent-cleanup --path '$worktree'." >&2
    exit "$wait_status"
fi

printf '\nCleanup requested (%s). Type %s to confirm workspace %s closure and worktree cleanup: ' "$cleanup" "${cleanup^^}" "$workspace" >&2
if [[ ! -t 0 || ! -t 1 ]]; then
    echo >&2
    echo "Cleanup requires an interactive terminal acknowledgement; nothing was removed." >&2
    exit 1
fi
read -r acknowledgement </dev/tty
[[ "$acknowledgement" == "${cleanup^^}" ]] || {
    echo "Acknowledgement did not match; nothing was removed." >&2
    exit 1
}

# Never close a workspace that launch merely reused.  A newly provisioned
# worktree should not normally hit this case, but retaining this guard keeps
# cleanup scoped to resources created by this invocation.
if [[ "$workspace_reused" == true ]]; then
    echo "Refusing cleanup: workspace $workspace was reused, not created by this invocation; worktree remains at $worktree." >&2
    exit 1
fi

close_output=""
if ! close_output=$(herdr workspace close "$workspace" 2>&1); then
    echo "Herdr workspace close failed for $workspace; worktree was not removed." >&2
    [[ -n "$close_output" ]] && printf '%s\n' "$close_output" >&2
    echo "Remaining worktree: $worktree" >&2
    exit 1
fi

echo "Closed Herdr workspace $workspace." >&2
cleanup_args=(--path "$worktree" --repo "$repo")
# A typed INTEGRATE acknowledgement confirms the reported commits were
# cherry-picked. Git cannot identify that relationship as a merge, so use the
# cleanup helper's explicit guarded force path for both acknowledged outcomes.
cleanup_args+=(--force-branch)
cleanup_output=""
if ! cleanup_output=$("$SCRIPT_DIR/wt-for-subagent-cleanup" "${cleanup_args[@]}" 2>&1); then
    echo "Worktree cleanup failed after workspace $workspace closed; inspect the remaining worktree." >&2
    [[ -n "$cleanup_output" ]] && printf '%s\n' "$cleanup_output" >&2
    echo "Remaining worktree: $worktree" >&2
    exit 1
fi
printf '%s\n' "$cleanup_output"
exit "$wait_status"
