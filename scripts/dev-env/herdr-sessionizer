#!/bin/bash

# Popups run with a minimal PATH (no Homebrew, no ~/.local/bin), so
# fzf/herdr aren't found unless we add them explicitly.
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"

PROJECT_FILE="$HOME/.project_dirs"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=worktree-helper
source "$SCRIPT_DIR/worktree-helper"

# Function to get the current git branch for a directory, if any
git_branch() {
    git -C "$1" branch --show-current </dev/null 2>/dev/null
}

# Expand one registered root into the root itself plus its currently
# registered worktrees, writing tab-separated path/branch lines to
# stdout. Mirrors tmux-sessionizer's expand_root.
expand_root() {
    local root="$1"
    local root_real repo_root path branch detached
    root_real=$(cd "$root" 2>/dev/null && pwd -P) || root_real="$root"
    branch=$(git_branch "$root")
    printf '%s\t%s\n' "$root" "$branch"

    repo_root=$(git -C "$root" rev-parse --show-toplevel 2>/dev/null) || repo_root=
    repo_root=$(cd "$repo_root" 2>/dev/null && pwd -P) || repo_root=
    if [[ -n "$repo_root" && "$root_real" == "$repo_root" ]]; then
        while IFS=$'\t' read -r path branch detached; do
            [[ "$path" == "$root_real" ]] && continue
            printf '%s\t%s\n' "$path" "$branch"
        done < <(worktree_records "$root" 2>/dev/null || true)
    fi
}

# Expand every registered root in parallel; see tmux-sessionizer for
# why this is parallelized rather than a sequential loop.
project_entries() {
    local root tmpdir
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/herdr-sessionizer.XXXXXX") || return 1
    trap 'rm -rf "$tmpdir"' RETURN

    local i=0 pids=()
    while IFS= read -r root <&3; do
        [[ -z "$root" ]] && continue
        i=$((i + 1))
        expand_root "$root" > "$tmpdir/$i" &
        pids+=($!)
    done 3< "$PROJECT_FILE"

    local pid
    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null
    done

    cat "$tmpdir"/* 2>/dev/null
}

# Find the workspace_id of an already-open Herdr workspace whose root
# pane cwd matches the given path, if any.
find_workspace_for() {
    local target="$1" ws_id
    while IFS= read -r ws_id; do
        [[ -z "$ws_id" ]] && continue
        local cwd
        cwd=$(herdr pane list --workspace "$ws_id" 2>/dev/null \
            | jq -r '.result.panes[0].cwd // empty')
        if [[ "$cwd" == "$target" ]]; then
            printf '%s\n' "$ws_id"
            return 0
        fi
    done < <(herdr workspace list 2>/dev/null | jq -r '.result.workspaces[].workspace_id')
    return 1
}

main() {
    local match="$1"

    if [[ ! -s "$PROJECT_FILE" ]]; then
        echo "No projects found. Register some in ~/.project_dirs first."
        return 1
    fi

    local selected

    if [[ -z "$match" ]]; then
        local entries width=0 dir branch
        entries=$(project_entries | awk -F '\t' '!seen[$1]++')

        while IFS=$'\t' read -r dir branch; do
            if (( ${#dir} > width )); then
                width=${#dir}
            fi
        done <<< "$entries"

        selected=$(
            while IFS=$'\t' read -r dir branch; do
                if [[ -n "$branch" ]]; then
                    printf '%-*s\t\033[33m[%s]\033[0m\n' "$width" "$dir" "$branch"
                else
                    printf '%-*s\t\n' "$width" "$dir"
                fi
            done <<< "$entries" \
            | fzf --ansi --height=40% --reverse \
                  --prompt="Select a project: " \
                  --delimiter='\t' --with-nth=1,2 --nth=1,2 \
                  | cut -f1
        )
        selected="${selected%"${selected##*[![:space:]]}"}"
    else
        selected=$(project_entries | grep -i "$match" | head -n 1 | cut -f1)
    fi

    if [[ -z "$selected" ]]; then
        echo "No match found for '$match'"
        return 1
    fi

    local ws_id
    if ws_id=$(find_workspace_for "$selected"); then
        herdr workspace focus "$ws_id" >/dev/null
    else
        herdr workspace create --cwd "$selected" --focus >/dev/null
    fi
}

main "$1"
