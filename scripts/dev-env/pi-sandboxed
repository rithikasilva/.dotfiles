#!/bin/bash
# Exec pi under the repository's macOS Seatbelt profile.
set -euo pipefail

script_path=${BASH_SOURCE[0]}
if [[ -L "$script_path" ]]; then
    script_path=$(readlink "$script_path")
fi
SCRIPT_DIR=$(cd "$(dirname "$script_path")" && pwd -P)
: "${PI_SANDBOX_WORKTREE:?PI_SANDBOX_WORKTREE is required}"

if [[ "$(uname -s)" != Darwin ]]; then
    echo "pi-sandboxed requires macOS (sandbox-exec)." >&2
    exit 1
fi

worktree=$(cd "$PI_SANDBOX_WORKTREE" 2>/dev/null && pwd -P) || {
    echo "Sandbox worktree does not exist: $PI_SANDBOX_WORKTREE" >&2
    exit 1
}
agent_dir=${PI_SANDBOX_AGENT_DIR:-$HOME/.pi/agent}
agent_dir=$(cd "$agent_dir" 2>/dev/null && pwd -P) || {
    echo "Pi agent directory does not exist: $agent_dir" >&2
    exit 1
}
config_source="$agent_dir"
if [[ -L "$agent_dir/settings.json" ]]; then
    config_target=$(readlink "$agent_dir/settings.json")
    config_source=$(cd "$(dirname "$agent_dir/settings.json")/$(dirname "$config_target")" 2>/dev/null && pwd -P) || {
        echo "Could not resolve pi settings source: $config_target" >&2
        exit 1
    }
fi
cargo_bin="$HOME/.cargo/bin"
tmpdir=${TMPDIR:-/tmp}
tmpdir=$(cd "$tmpdir" 2>/dev/null && pwd -P) || {
    echo "Temporary directory does not exist: $TMPDIR" >&2
    exit 1
}

# Seatbelt cannot match arbitrary remote IPs/hostnames on this macOS version:
# its remote address grammar accepts only '*' or 'localhost'. Run a tiny
# host-side CONNECT proxy that permits exactly chatgpt.com:443, then allow pi
# only to that proxy's loopback port.
profile=$(mktemp "$tmpdir/pi-sandbox-profile.XXXXXX") || {
    echo "Could not create temporary sandbox profile." >&2
    exit 1
}
proxy_log=$(mktemp "$tmpdir/pi-sandbox-proxy.XXXXXX") || {
    rm -f "$profile"
    echo "Could not create proxy status file." >&2
    exit 1
}
/opt/homebrew/bin/node "$SCRIPT_DIR/pi-sandbox-proxy.cjs" >"$proxy_log" 2>&1 &
proxy_pid=$!
cleanup_sandbox() {
    kill "$proxy_pid" 2>/dev/null || true
    rm -f "$profile" "$proxy_log"
}
trap cleanup_sandbox EXIT
proxy_port=""
for _ in {1..50}; do
    proxy_port=$(awk '$1 == "READY" { print $2; exit }' "$proxy_log")
    [[ -n "$proxy_port" ]] && break
    kill -0 "$proxy_pid" 2>/dev/null || break
    sleep 0.02
done
if [[ -z "$proxy_port" ]]; then
    echo "Provider proxy failed to start: $(cat "$proxy_log")" >&2
    exit 1
fi
cp "$SCRIPT_DIR/pi-sandbox.sb" "$profile"
printf '(allow network-outbound (remote ip "localhost:%s"))\n' "$proxy_port" >>"$profile"

export PI_SANDBOX_PROXY="http://127.0.0.1:$proxy_port"
export NODE_OPTIONS="--require=$SCRIPT_DIR/pi-sandbox-fetch-proxy.cjs${NODE_OPTIONS:+ $NODE_OPTIONS}"
exec /usr/bin/sandbox-exec \
    -f "$profile" \
    -D "WORKTREE=$worktree" \
    -D "PI_AGENT=$agent_dir" \
    -D "PI_CONFIG_SOURCE=$config_source" \
    -D "PI_SANDBOX_TOOLS=$SCRIPT_DIR" \
    -D "CARGO_BIN=$cargo_bin" \
    -D "TMPDIR=$tmpdir" \
    /opt/homebrew/bin/pi "$@"
