[global]
separator_color = frame
frame_width = 2
frame_color = "#878787"  # Using 'active_border_color' from Kitty config (neutral grey)
offset = 15x15
width = 300
padding = 10
corner_radius = 10

[urgency_low]
background = "#141415"  # Using 'background' from your theme (dark grey)
foreground = "#cdcdcd"  # Using 'foreground' from your theme (light grey)

[urgency_normal]
background = "#141415"  # Using 'background' from your theme (dark grey)
foreground = "#cdcdcd"  # Using 'foreground' from your theme (light grey)

[urgency_critical]
background = "#df6882"  # Using 'color1' (red, for critical urgency)
foreground = "#cdcdcd"  # Using 'foreground' from your theme
